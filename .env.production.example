# Template for docker-compose.prod.yml's `.env`. Do not commit a copy of
# this file with real values — per docs/launch.md §2.3, values are sourced
# from the fleet's secrets manager and injected by its deploy mechanism.

# --- MySQL (docs/launch.md §3) ---
MYSQL_DATABASE=global_combat_prod
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Phoenix (docs/launch.md §2.3) ---
# ecto://USER:PASS@mysql/DATABASE — must match the MySQL_* values above.
DATABASE_URL=
# Generate once via `mix phx.gen.secret`, store in the secrets manager, never rotate
# casually (rotating invalidates all live sessions/cookies).
SECRET_KEY_BASE=
# Whichever domain is live per docs/launch.md §1 — not a secret, but must
# track DNS.
PHX_HOST=

# --- Mailer (docs/launch.md §2.3 Gaps — provider undecided) ---
MAILGUN_API_KEY=

# --- Fleet reverse proxy (docs/launch.md §2.1) ---
# Name of the fleet's existing external Docker network that terminates TLS;
# this repo does not create or name it.
PROXY_NETWORK=

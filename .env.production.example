# Template for docker-compose.prod.yml's `.env`. Never commit a filled-in copy.
# (Kamal deploys read .kamal/secrets instead; see docs/deploy/oracle-kamal.md.)

POSTGRES_DB=global_combat_prod
POSTGRES_USER=
POSTGRES_PASSWORD=

# ecto://USER:PASS@postgres/DATABASE, matching the POSTGRES_* values above.
DATABASE_URL=
# Generate once (`openssl rand -base64 64`); rotating it logs everyone out.
SECRET_KEY_BASE=
# The live domain.
PHX_HOST=

# Optional. Leave MAILGUN_API_KEY empty to log emails instead of sending them;
# when it's set, MAILGUN_DOMAIN is required.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILER_FROM=

# Docker network of the reverse proxy that terminates TLS.
PROXY_NETWORK=

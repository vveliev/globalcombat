# Secrets for config/deploy.yml. Committed, so it only references your shell
# environment (or a `kamal secrets fetch` lookup). Never paste a real value here.

# GitHub token with write:packages, for ghcr.io/vveliev/globalcombat.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

SECRET_KEY_BASE=$SECRET_KEY_BASE
# ecto://POSTGRES_USER:POSTGRES_PASSWORD@globalcombat-postgres/global_combat_prod
DATABASE_URL=$DATABASE_URL
# Optional; leave unset to log emails instead of sending them.
MAILGUN_API_KEY=$MAILGUN_API_KEY

POSTGRES_USER=$POSTGRES_USER
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

<div class="mx-auto max-w-sm px-4 py-16">
  <h1 class="text-2xl font-semibold mb-6">Register</h1>

  <.form
    :let={f}
    for={@changeset}
    as={:account}
    action={~p"/account/register"}
    method="post"
    class="flex flex-col gap-4"
  >
    <.input field={f[:name]} type="text" label="Login name" required autofocus />
    <.input field={f[:email]} type="email" label="Email address" required />
    <.input field={f[:password]} type="password" label="Password" required />
    <.input field={f[:password_confirmation]} type="password" label="Confirm password" required />
    <.button variant="primary" class="mt-2">Register</.button>
  </.form>

  <div class="mt-6 text-sm">
    <.link navigate={~p"/account/log-on"}>Already have an account? Log on</.link>
  </div>

  <div class="mt-10 pt-6 border-t border-border text-sm text-text-muted">
    <h2 class="font-semibold text-text mb-2">Code of Conduct</h2>
    <ul class="list-disc list-inside flex flex-col gap-1">
      <li>Don't play with multiple accounts, that's just lame.</li>
      <li>Be respectful and don't abuse fellow players.</li>
      <li>
        If you break these rules your account will be disabled and your IP address will be banned.
      </li>
    </ul>
  </div>
</div>

<.site_chrome current_account={@current_account}>
  <div class="max-w-lg">
    <h1 class="text-2xl font-semibold mb-6">Contact Us</h1>

    <p :if={@result_message} class="alert alert-info mb-4">{@result_message}</p>

    <p class="mb-6 text-text-muted">Tell us what you really think!</p>

    <.form
      :let={f}
      for={%{}}
      as={:contact}
      action={~p"/account/contact"}
      method="post"
      class="flex flex-col gap-4"
    >
      <.input field={f[:subject]} type="text" name="subject" label="Subject" required />
      <.input field={f[:comments]} type="textarea" name="comments" label="Message" required />
      <.button variant="primary" class="mt-2">Send Message</.button>
    </.form>
  </div>
</.site_chrome>

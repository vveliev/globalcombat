<.site_chrome current_account={@current_account} current_path={assigns[:current_path]}>
  <div class="mx-auto w-full max-w-md py-[var(--space-6)] sm:py-[var(--space-8)] flex flex-col gap-[var(--space-5)]">
    <header class="flex flex-col gap-[var(--space-2)]">
      <Kicker.kicker>Feedback</Kicker.kicker>
      <h1 class="heading-3">Contact Us</h1>
      <p class="text-sm text-text-muted">
        Tell us what you really think! Replies go to the email address on your account.
      </p>
    </header>

    <Card.card>
      <div class="flex flex-col gap-[var(--space-5)]">
        <.inline_message
          :if={@result_message}
          id="result-message"
          intent={if @result_error?, do: "danger", else: "success"}
        >
          {@result_message}
        </.inline_message>

        <.form
          :let={f}
          for={%{"subject" => @subject, "comments" => @comments}}
          as={:contact}
          action={~p"/account/contact"}
          method="post"
          class="flex flex-col gap-[var(--space-4)]"
        >
          <Input.input
            field={f[:subject]}
            type="text"
            name="subject"
            label="Subject"
            required
            aria-invalid={@result_error? && "true"}
            aria-describedby={@result_error? && "result-message"}
          />
          <Input.input
            field={f[:comments]}
            type="textarea"
            name="comments"
            label="Message"
            rows="6"
            required
            aria-invalid={@result_error? && "true"}
            aria-describedby={@result_error? && "result-message"}
          />
          <Button.button
            type="submit"
            class="w-full min-h-[var(--size-touch-target)] touch-manipulation"
          >
            Send Message
          </Button.button>
        </.form>
      </div>
    </Card.card>
  </div>
</.site_chrome>

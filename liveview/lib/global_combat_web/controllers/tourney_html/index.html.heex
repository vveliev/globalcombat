<div class="mx-auto max-w-3xl px-4 py-10">
  <h2 class="text-2xl font-semibold mb-4">Tournament - {@tourney.name}</h2>

  <span :if={@message} class="text-error block mb-2">{@message}</span>

  <table class="mb-4">
    <tbody>
      <tr>
        <td class="font-semibold pr-4">Description</td>
        <td>{@tourney.description}</td>
      </tr>
      <tr>
        <td class="font-semibold pr-4">Players</td>
        <td>{@tourney.max_players}</td>
      </tr>
      <tr>
        <td class="font-semibold pr-4">Initial Game Size</td>
        <td>{@tourney.game_size}</td>
      </tr>
      <tr>
        <td class="font-semibold pr-4">Winners</td>
        <td>{@tourney.winners} from each game</td>
      </tr>
    </tbody>
  </table>

  <div :if={
    @current_account && not Tourney.started?(@tourney) && not playing?(@players, @current_account)
  }>
    <.link href={"/Tournament-#{@tourney.id}/Join"}>Join This Tournament</.link>
  </div>

  <h2 :if={@tourney.double_elimination} class="text-xl font-semibold mt-6 mb-2">Main Bracket</h2>

  <table class="border-0" cellpadding="10">
    <tr>
      <.bracket_round
        :for={round <- @bracket.winner_bracket}
        round={round}
        tourney={@tourney}
        tourney_games={@tourney_games}
      />
    </tr>
  </table>

  <div :if={@tourney.double_elimination}>
    <h2 class="text-xl font-semibold mt-6 mb-2">Loser Bracket</h2>
    <table class="border-0" cellpadding="10">
      <tr>
        <.bracket_round
          :for={round <- @bracket.loser_bracket}
          round={round}
          tourney={@tourney}
          tourney_games={@tourney_games}
        />
      </tr>
    </table>

    <h2 class="text-xl font-semibold mt-6 mb-2">Final Game</h2>
    <table class="border-0" cellpadding="10">
      <tr>
        <.bracket_round
          round={@bracket.final_round}
          tourney={@tourney}
          tourney_games={@tourney_games}
        />
      </tr>
    </table>
  </div>

  <div :if={not Tourney.started?(@tourney)}>
    <h2 class="text-xl font-semibold mt-6 mb-2">Players Signed Up: {@current_players}</h2>
    <div :for={account <- @players}>
      <.link href={"/Player-Info-#{account.id}"}>{account.name}</.link>
    </div>
  </div>

  <div :if={@current_account && not Tourney.started?(@tourney)} class="mt-4">
    <.link :if={not playing?(@players, @current_account)} href={"/Tournament-#{@tourney.id}/Join"}>
      Join This Tournament
    </.link>
    <.link :if={playing?(@players, @current_account)} href={"/Tournament-#{@tourney.id}/Quit"}>
      Quit This Tournament
    </.link>
    <div :if={@current_account.admin}>
      <.link href={"/Tournament-#{@tourney.id}?StartTourney=1"}>START TOURNEY</.link>
    </div>
  </div>

  <div :if={@current_account && @current_account.admin} class="mt-4">
    <.link href={"/Tournament-#{@tourney.id}?KillTourney=1"}>KILL TOURNEY</.link>
  </div>
</div>

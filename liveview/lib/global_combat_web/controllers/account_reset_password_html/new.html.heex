<.auth_card
  title="Lost Password"
  kicker="Account recovery"
  lede="Enter your login name or email address and we'll email you a new password."
  current_account={@current_account}
  current_path={assigns[:current_path]}
  flash={@flash}
>
  <.inline_message :if={@error_message} id="login-error" intent="danger">
    {@error_message}
  </.inline_message>

  <.form
    :let={f}
    for={%{}}
    as={:account}
    action={~p"/account/reset-password"}
    method="post"
    class="flex flex-col gap-[var(--space-4)]"
  >
    <Input.input
      field={f[:login]}
      type="text"
      label="Login name or email"
      autocomplete="username"
      autocapitalize="none"
      spellcheck="false"
      autofocus
      required
      aria-invalid={@error_message && "true"}
      aria-describedby={@error_message && "login-error"}
    />
    <Button.button
      type="submit"
      class="w-full min-h-[var(--size-touch-target)] touch-manipulation"
    >
      Email me a new password
    </Button.button>
  </.form>

  <:footer>
    <p>
      Remembered it?
      <.link navigate={~p"/account/log-on"} class="font-semibold text-primary hover:underline">
        Back to log on
      </.link>
    </p>
  </:footer>
</.auth_card>

<.auth_card
  title="Log On"
  kicker="Welcome back"
  lede="Log on with your login name or email address."
  current_account={@current_account}
  current_path={assigns[:current_path]}
  flash={@flash}
>
  <.inline_message :if={@error_message} id="login-error" intent="danger">
    {@error_message}
  </.inline_message>

  <.form
    :let={f}
    for={%{"login" => @login}}
    as={:account}
    action={~p"/account/log-on"}
    method="post"
    class="flex flex-col gap-[var(--space-4)]"
  >
    <Input.input
      field={f[:login]}
      type="text"
      label="Login name or email"
      autocomplete="username"
      autocapitalize="none"
      spellcheck="false"
      required
      aria-invalid={@error_message && "true"}
      aria-describedby={@error_message && "login-error"}
    />
    <Input.input
      field={f[:password]}
      type="password"
      value=""
      label="Password"
      autocomplete="current-password"
      required
      aria-invalid={@error_message && "true"}
      aria-describedby={@error_message && "login-error"}
    />
    <.link
      navigate={~p"/account/reset-password"}
      class="self-end -mt-[var(--space-2)] text-sm text-primary hover:underline"
    >
      Forgot your password?
    </.link>
    <Button.button
      type="submit"
      class="w-full min-h-[var(--size-touch-target)] touch-manipulation"
    >
      Log On
    </Button.button>
  </.form>

  <:footer>
    <p>
      New to Global Combat?
      <.link navigate={~p"/account/register"} class="font-semibold text-primary hover:underline">
        Create an account
      </.link>
    </p>
  </:footer>
</.auth_card>

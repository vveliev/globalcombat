<.site_chrome current_account={@current_account}>
  <Card.card>
    <div class="prose prose-sm max-w-none text-text [&_h2]:font-semibold [&_h3]:font-semibold [&_table]:border-collapse [&_td]:border [&_td]:border-border [&_td]:px-[var(--space-2)] [&_td]:py-[var(--space-1)]">
      {raw(@manual_html)}
    </div>
  </Card.card>
</.site_chrome>

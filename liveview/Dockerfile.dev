# Dev-only image for the local docker-compose stack (block 11400, see
# ../docker-compose.yml). Not a release build — source is bind-mounted at
# runtime for live reload, this image only carries the toolchain.
FROM hexpm/elixir:1.17.3-erlang-27.1.2-debian-bookworm-20241016-slim

RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends build-essential git ca-certificates inotify-tools \
  && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=dev
WORKDIR /app

CMD ["sh", "-c", "mix deps.get && mix ecto.create --quiet && mix ecto.migrate && mix run priv/repo/seeds.exs && mix phx.server"]

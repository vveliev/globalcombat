# Extra .env keys for the OCI deployment. Append these to the .env built from
# .env.production.example (repo root). Never commit the filled-in file.

# Network Caddy and `web` share; created by cloud-init.yaml.
PROXY_NETWORK=gc-proxy

# Let's Encrypt account contact (expiry/revocation notices only).
ACME_EMAIL=

# Optional: OCI Object Storage bucket for off-VM backups (deploy/oci/backup.sh).
# Leave empty to keep backups on the VM only.
OCI_BACKUP_BUCKET=

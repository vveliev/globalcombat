# TLS-terminating reverse proxy for the Phoenix app (deploy/oci/docker-compose.oci.yml).
#
# Caddy obtains and renews the Let's Encrypt certificate for PHX_HOST on its
# own, proxies LiveView WebSockets without extra config, and sets
# X-Forwarded-Proto, which config/prod.exs's force_ssl `rewrite_on` relies on
# to avoid a redirect loop. HSTS and the other browser security headers come
# from Phoenix itself (force_ssl + put_secure_browser_headers), so they are
# not repeated here.

{
	email {$ACME_EMAIL}
}

{$PHX_HOST} {
	encode zstd gzip

	header -Server

	reverse_proxy web:4000
}

#!/bin/sh
# Block a push that would publish internal references. Install with:
#   git config core.hooksPath .githooks
#
# Local hooks are advisory — they are per-clone and bypassable with
# --no-verify. The CI job is the gate that actually holds; this exists so the
# failure arrives in two seconds instead of after a round trip.
#
# git feeds one line per ref on stdin: <local ref> <local sha> <remote ref>
# <remote sha>. Each pushed ref is scanned against what the remote already has
# (or, for a brand-new branch, against the merge-base with the remote's main),
# so the scan covers exactly what this push publishes. Deletions publish
# nothing and are skipped.
remote="$1"
zero=0000000000000000000000000000000000000000
script="$(git rev-parse --show-toplevel)/scripts/check-internal-refs.mjs"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # delete
  if [ "$remote_sha" != "$zero" ]; then
    base="$remote_sha"
  else
    base="$(git merge-base "$local_sha" "refs/remotes/$remote/main" 2>/dev/null \
      || git merge-base "$local_sha" main 2>/dev/null \
      || git rev-list --max-parents=0 "$local_sha" | tail -1)"
  fi
  [ "$base" = "$local_sha" ] && continue # nothing new
  node "$script" --range "$base..$local_sha" || status=1
done

exit $status

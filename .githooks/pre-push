#!/bin/sh
# Block a push that would publish internal references. Install with:
#   git config core.hooksPath .githooks
#
# Local hooks are advisory — they are per-clone and bypassable with
# --no-verify. The CI job is the gate that actually holds; this exists so the
# failure arrives in two seconds instead of after a round trip.
#
# git feeds one line per ref on stdin: <local ref> <local sha> <remote ref>
# <remote sha>. Each pushed ref is scanned against what the remote already has;
# for a brand-new branch the scanner falls back to the merge-base with the
# remote's main. Deletions publish nothing and are skipped.
remote="$1"
url="$2"
zero=0000000000000000000000000000000000000000
script="$(git rev-parse --show-toplevel)/scripts/check-internal-refs.mjs"

# The fallback for a brand-new branch is the TARGET remote's main — asked of
# the remote itself, so it is right whether the push names a remote or a bare
# URL, and whether or not a remote-tracking ref for it exists locally. (A guess
# such as refs/remotes/origin/main is wrong on a fork whose `origin` is the
# upstream repo: that merge-base is the fork point, and the scan would re-flag
# the fork's entire history.) If the remote's main is not fetched locally, fall
# back to the remote-tracking ref, then local main.
main_sha="$(git ls-remote --quiet "$url" refs/heads/main 2>/dev/null | cut -f1)"
if [ -n "$main_sha" ] && git cat-file -e "$main_sha^{commit}" 2>/dev/null; then
  fallback="$main_sha"
else
  case "$remote" in
    *://*|*@*:*) remote="$(git remote -v | awk -v u="$url" '$2 == u { print $1; exit }')" ;;
  esac
  fallback="refs/remotes/${remote:-origin}/main"
  git rev-parse --verify -q "$fallback" >/dev/null 2>&1 || fallback=main
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # delete
  node "$script" --range "$remote_sha..$local_sha" --base-fallback "$fallback" \
    --branch "${local_ref#refs/heads/}" </dev/null || status=1
done
exit $status
